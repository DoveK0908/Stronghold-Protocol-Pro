# Normalise line endings in the repository; check out Windows scripts with CRLF (cmd.exe needs it for labels/goto)
# and shell scripts with LF, whatever core.autocrlf says on the cloning machine.
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf
*.mjs text eol=lf
*.js  text eol=lf
*.py  text eol=lf
# Text the tests read and match line by line (CSS rules, HTML, data, docs): LF everywhere, so a Windows checkout
# (core.autocrlf=true) runs `node --test` exactly like Linux and macOS.
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
# Preserve the exact bytes/hashes of upstream moderation licenses, including their original whitespace.
deploy/stardust/auth/NAME-*-LICENSE.txt -text whitespace=-blank-at-eol
# Frozen upstream AI sources: manifests hash original bytes, not normalized text.
# Keep upstream whitespace rather than reformatting vendored policy files.
server/match/arturia/policy/** -text whitespace=cr-at-eol,-blank-at-eof
server/match/arturia/compat/** -text whitespace=cr-at-eol,-blank-at-eof
server/match/arturia/runtime/** -text whitespace=cr-at-eol,-blank-at-eof
server/match/lavinia/policy/** -text whitespace=cr-at-eol,-blank-at-eof
server/match/lavinia/compat/** -text whitespace=cr-at-eol,-blank-at-eof
server/match/lavinia/runtime/** -text whitespace=cr-at-eol,-blank-at-eof
server/match/aiAddons/zumama/policy/** -text whitespace=cr-at-eol,-blank-at-eof
server/match/aiAddons/zumama/compat/** -text whitespace=cr-at-eol,-blank-at-eof
server/match/aiAddons/zumama/runtime/** -text whitespace=cr-at-eol,-blank-at-eof
server/match/arturia/runtime.js -text whitespace=cr-at-eol,-blank-at-eof
server/match/lavinia/runtime.js -text whitespace=cr-at-eol,-blank-at-eof
server/match/aiAddons/zumama/runtime.js -text whitespace=cr-at-eol,-blank-at-eof
server/match/aiCompute/** -text whitespace=cr-at-eol,-blank-at-eof
server/match/arturia/LICENSE -text
server/match/lavinia/LICENSE -text
server/match/aiAddons/zumama/LICENSE -text
